# Environment Configuration for CivicPulse AI
PROJECT_NAME="CivicPulse AI"
VERSION="1.0.0"

# Database Configuration (SQLite default; can point to PostgreSQL / PostGIS)
DATABASE_URL="sqlite:///./civicpulse.db"
# DATABASE_URL="postgresql://civicuser:civicpassword@localhost:5432/civicpulse_db"

# Server Host and Port
HOST="0.0.0.0"
PORT=8000

# Live Geospatial & Weather APIs (No API key needed)
NOMINATIM_URL="https://nominatim.openstreetmap.org/reverse"
NOMINATIM_USER_AGENT="CivicPulseAI-Engine/1.0 (civicpulse-contact@gov.local)"
OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"

# AI Model Settings
YOLO_MODEL_PATH="weights/yolov8n.pt"
WHISPER_MODEL_SIZE="base"

# Spatio-Temporal Clustering
DBSCAN_EPSILON_METERS=35.0
